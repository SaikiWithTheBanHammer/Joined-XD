local function makeDraggable(obj, clickableChildren, target)
    target = target or obj
    local dragging, dragStart, startPos, moved = false, nil, nil, false
    local ib = obj.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            if clickableChildren then
                local mp = input.Position
                for _,c in ipairs(clickableChildren) do
                    if c:IsA("GuiObject") then
                        local ap,sz = c.AbsolutePosition, c.AbsoluteSize
                        if mp.X>=ap.X and mp.X<=ap.X+sz.X and mp.Y>=ap.Y and mp.Y<=ap.Y+sz.Y then return end
                    end
                end
            end
            dragging=true moved=false dragStart=input.Position startPos=target.Position
        end
    end)
    table.insert(connections, ib)
    local ic = obj.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            if math.abs(d.X)>5 or math.abs(d.Y)>5 then moved=true end
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+d.X, startPos.Y.Scale, startPos.Y.Offset+d.Y)
        end
    end)
    table.insert(connections, ic)
    local ie = obj.InputEnded:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end
    end)
    table.insert(connections, ie)
    return function() return moved end, function() moved=false end
end

