local function sanitizeUtf8(t)
    t = tostring(t or "")
    if t=="" then return "" end
    return t:gsub("%z","")
end

local function utf8TruncateEnd(text, maxChars)
    if not utf8 then return tostring(text or ""):sub(1,maxChars).."..." end
    text = sanitizeUtf8(text)
    if text=="" then return "" end
    local ok, n = pcall(function() return utf8.len(text) end)
    if not ok or not n then
        if #text<=maxChars then return text end
        return text:sub(1,maxChars).."..."
    end
    if n<=maxChars then return text end
    local p = utf8.offset(text, maxChars+1)
    if not p then return text end
    return text:sub(1,p-1).."..."
end

