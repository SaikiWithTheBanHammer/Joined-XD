    local function buildStickerButton(thisSticker)
        local btn = Instance.new("ImageButton")
        btn.Size=UDim2.new(0,90,0,90) btn.BackgroundColor3=Color3.fromRGB(20,20,25)
        btn.BorderSizePixel=1 btn.BorderColor3=Color3.fromRGB(50,50,50)
        btn.Image = thisSticker.id or "rbxassetid://0" btn.ZIndex=42
        btn.MouseButton1Click:Connect(function()
            pcall(function() fetchGlobalBlocks(true) end)
            if blockedUsers["__ALL__"] then
                stickerPanel.Visible=false
                if addSystemMessage then
                    addSystemMessage("🚫 You are blocked and cannot send memes.", Color3.fromRGB(255,100,100))
                end
                return
            end

            stickerPanel.Visible=false
            task.spawn(function()
                pcall(function() fetchGlobalBlocks(true) end)
                if blockedUsers["__ALL__"] then
                    if addSystemMessage then
                        addSystemMessage("🚫 You are blocked and cannot send memes.", Color3.fromRGB(255,100,100))
                    end
                    return
                end

                if thisSticker.hash and thisSticker.hash~="" then
                    local foundPath = fileExistsForHash(thisSticker.hash)
                    if foundPath then
                        local ok, data = pcall(readfile, foundPath)
                        if ok and data and #data>0 and #data<=MAX_MEME_BYTES then
                            syncedHashes[thisSticker.hash]=true
                        end
                    end
                end
                -- make sure the meme data exists on the server so other clients can load it
                if thisSticker.hash and thisSticker.hash~="" then
                    local upHash = tostring(thisSticker.hash)
                    task.spawn(function()
                        local foundPath = fileExistsForHash(upHash)
                        if not foundPath or not readfile then return end
                        local remote = jsonDecode(httpGetFresh(SYNCED_MEMES_ROOT.."/"..upHash..".json") or "{}")
                        if remote and remote.data and remote.data~="" then return end
                        local ok, data = pcall(readfile, foundPath)
                        if ok and data and #data>0 and #data<=MAX_MEME_BYTES and dataHash(data)==upHash then
                            local b64 = b64Encode(data)
                            if b64 and b64~="" then
                                local fname = tostring(foundPath):match("([^/\\]+)$") or "MEME"
                                local nm = string.upper(fname:gsub("%.[^.]+$",""):gsub("%W","_"):sub(1,20))
                                local ext = foundPath:match("%.[^%.]+$") or ".png"
                                httpPut(SYNCED_MEMES_ROOT.."/"..upHash..".json", jsonEncode({name=nm, data=b64, hash=upHash, ext=ext, size=#data, by=player.Name, timestamp=os.time()*1000}))
                            end
                        end
                    end)
                end
                task.wait(0.2)
                local msgId = generateGUID()
                seenIds[msgId]=true
                local isGlobal = false
                if thisSticker.id and thisSticker.id:find("rbxassetid://",1,true) then isGlobal=true end
                local sendStickerId = thisSticker.id or ""
                if thisSticker.hash and thisSticker.hash~="" and not isGlobal then sendStickerId="" end
                local payload = {name=player.Name, displayName=player.DisplayName, message="[STICKER] "..thisSticker.name, sticker_hash=thisSticker.hash or "", sticker=sendStickerId, ext=thisSticker.ext or "", timestamp={[".sv"]="timestamp"}, id=msgId, role=myRole, userId=player.UserId, to=privateTarget}
                local localReply = nil
                if replyingTo then
                    payload.replySender=replyingTo.sender
                    payload.replyText=utf8TruncateEnd(replyingTo.text, 80)
                    payload.replyId=replyingTo.id
                    localReply = {sender=replyingTo.sender, text=replyingTo.text}
                    clearReplyMode()
                end
                httpPost(FIREBASE_URL, jsonEncode(payload))
                addChatMessage(player.DisplayName, payload.message, true, myRole, player.UserId, privateTarget, thisSticker.id, localReply, thisSticker.hash)
            end)
        end)
        return btn
    end

    local function refreshStickers(force)
        dedupStickers()
        local want, order = {}, {}
        for _, sticker in ipairs(MEME_STICKERS) do
            local key = (sticker.hash and sticker.hash~="" and sticker.hash) or sticker.id
            if key and not want[key] then
                want[key]=sticker
                order[#order+1]=key
            end
        end
        for key, btn in pairs(drawnStickerKeys) do
            if not want[key] then
                if btn.Parent then btn:Destroy() end
                drawnStickerKeys[key]=nil
            end
        end
        for i, key in ipairs(order) do
            if not drawnStickerKeys[key] then
                local btn = buildStickerButton(want[key])
                btn.LayoutOrder=i
                btn.Parent=stickerScroller
                drawnStickerKeys[key]=btn
                if i % UI_BUILD_YIELD_EVERY == 0 then task.wait() end
            end
        end
        stickerScroller.CanvasSize=UDim2.new(0,#order*96,0,0)
    end

