    local lastServerPrune = 0
    local FIREBASE_PRUNE_COOLDOWN = 120
    local function pruneServerMessages(force)
        if true then return end
        local now = os.clock()
        if not force and now-lastServerPrune<FIREBASE_PRUNE_COOLDOWN then return end
        lastServerPrune = now
        task.spawn(function()
            local raw = httpGetFresh(FIREBASE_URL)
            local data = jsonDecode(raw or "{}")
            if type(data)~="table" then return end
            local rows = {}
            for key, entry in pairs(data) do
                if type(entry)=="table" and entry.message and entry.timestamp then
                    rows[#rows+1] = {key=tostring(key), timestamp=tonumber(entry.timestamp) or 0}
                end
            end
            local excess = #rows-MAX_MESSAGES
            if excess<=0 then return end
            table.sort(rows, function(a,b) return a.timestamp<b.timestamp end)
            for i=1,excess do
                httpDelete(FIREBASE_ROOT.."/"..rows[i].key..".json")
                task.wait(0.12)
            end
        end)
    end

    local function sendToServer(name, displayName, msg)
        if blockedUsers["__ALL__"] then return false end
        if #msg==0 then return false end
        local shownMessage = msg
        local msgId = generateGUID()
        seenIds[msgId]=true
        local replyToSend = nil
        if replyingTo then replyToSend = {sender=replyingTo.sender, text=replyingTo.text} end
        addChatMessage(displayName, shownMessage, true, myRole, player.UserId, privateTarget, nil, replyToSend, nil)
        if player.Character then makeBubble(player.Character, shownMessage) end
        local targetPlayer = privateTarget and Players:FindFirstChild(privateTarget) or nil
        local data = {
            name=name, displayName=displayName, message=shownMessage,
            timestamp={[".sv"]="timestamp"}, id=msgId, role=myRole, userId=player.UserId,
            to=privateTarget,
            toUserId=targetPlayer and targetPlayer.UserId or nil
        }
        if replyingTo then
            data.replySender=replyingTo.sender
            data.replyText=replyingTo.text
            data.replyId=replyingTo.id
            clearReplyMode()
        end
        local jsonData = jsonEncode(data)
        local resp = nil
        for _=1,3 do resp = httpPost(FIREBASE_URL, jsonData) if resp then break end task.wait(0.5) end
        if resp then pruneServerMessages(false) end
        return resp~=nil
    end

    local lastMsgKey = nil
    local function fetchNewMessagesUnsafe()
        local fetchUrl = MESSAGE_FETCH_URL
        if lastMsgKey then fetchUrl = fetchUrl.."&startAt=%22"..HttpService:UrlEncode(lastMsgKey).."%22" end
        local resp = httpGetFresh(fetchUrl)
        if not resp or tostring(resp):find('"error"', 1, true) then
            return
        end
        local data = jsonDecode(resp)
        if type(data)~="table" or data.error then return end
        local maxTs = lastTimestamp
        for entryKey, entry in pairs(data) do
            -- [EDIT 1] Firebase keys start with "-" and sort chronologically.
            if type(entryKey)=="string" and entryKey:match("^%-[%w_%-]+$") and (not lastMsgKey or entryKey>lastMsgKey) then lastMsgKey=entryKey end
            local isJoinShape = type(entry)=="table" and entry.system==true and entry.event=="join"
            if type(entry)=="table" and (entry.rx==1 or isJoinShape) then
                local ts = tonumber(entry.timestamp) or 0
                if ts>0 and ts<100000000000 then ts=ts*1000 end
                local name = entry.name
                local displayName = entry.displayName or entry.name
                local msg = entry.message
                local to = entry.to
                local isJoinEvent = isJoinShape
                local eventName = name or (isJoinEvent and displayName) or (isJoinEvent and entry.userId and tostring(entry.userId))
                local id = entry.id or ((eventName or entry.userId or "")..":"..ts..":"..(msg or entry.event or ""))
                if entry.isMusic or entry.musicAssetId then
                    seenIds[id]=true
                    if ts>maxTs then maxTs=ts end
                elseif seenIds[id] then
                    if ts>maxTs then maxTs=ts end
                else
                    local allowed = true
                    if to and to~="" then
                        local toString = tostring(to)
                        local isForMe = (toString == tostring(player.UserId) or toString == tostring(player.Name))
                        local isFromMe = (tostring(name) == tostring(player.Name))
                        if not isForMe and not isFromMe then allowed=false end
                    end
                    if eventName and (msg or isJoinEvent) and allowed and
                        ((isJoinEvent and tostring(entry.userId or eventName)~=tostring(player.UserId)) or
                        (not isJoinEvent and name~=player.Name)) and
                        not blockedUsers[eventName] then
                        if isJoinEvent or not isContentDuplicate(entry.userId or eventName, msg) then
                            local isFreshJoin = isJoinEvent and (ts==0 or ts>=SESSION_STARTED_AT)
                            if isJoinEvent and not isFreshJoin then
                                seenIds[id]=true
                            end
                            if ts < SESSION_CUTOFF then
                                seenIds[id] = true
                            elseif isFreshJoin or ts>=lastTimestamp-86400000 then
                                seenIds[id]=true
                                local isConnectionTest = tostring(id):find("^rx_chat_connected_") and true or false
                                local senderBlocked = entry.userId and globalBlocks[tostring(entry.userId)] and true or false
                                if not isConnectionTest and not senderBlocked then
                                    if entry.system then
                                        if entry.event=="clearall" then
                                            for _,child in pairs(scroller:GetChildren()) do
                                                if (child:IsA("TextLabel") or child:IsA("Frame")) and child.Name~="BottomSpacer" then child:Destroy() end
                                            end
                                            messageQueue = {}
                                            trackedHeight=0
                                            seenIds={} recentContent={} recentJoins={}
                                            seenIds[id] = true
                                            lastTimestamp=tonumber(entry.timestamp) or os.time()*1000
                                            addSystemMessage("Chat cleared by "..(entry.by or "staff"), Color3.fromRGB(0,200,255))
                                        elseif entry.event=="join" then
                                            local joinedName = tostring(entry.displayName or displayName or eventName or "Unknown player")
                                            local joinedRole = resolveRole(nil, entry.userId or 0)
                                            local isOwnerJoin = (joinedRole == "owner")
                                            local joinedText
                                            if isOwnerJoin then
                                                joinedText = "👑 "..string.upper(joinedName).." — OWNER HAS ARRIVED IN RX CHAT 👑"
                                            else
                                                joinedText = string.upper(joinedName.." HAS BEEN JOINED RX CHAT")
                                            end
                                            if tostring(entry.userId or eventName or "")~=tostring(player.UserId) then
                                                local displayed = false
                                                pcall(function()
                                                    displayed = showUnifiedJoin(eventName, joinedName, entry.userId or 0) == true
                                                end)
                                                if displayed then
                                                    if isOwnerJoin then
                                                        local okOwnerMsg = pcall(addOwnerJoinSystemMessage, joinedText)
                                                        if not okOwnerMsg then addSystemMessage(joinedText, Color3.fromRGB(255,200,0)) end
                                                    else
                                                        addSystemMessage(joinedText, Color3.fromRGB(80,230,255))
                                                    end
                                                end
                                            end
                                        else
                                            addSystemMessage(msg, Color3.fromRGB(255,210,80))
                                        end
                                    else
                                        local isStickerMsg = msg:find("%[STICKER%]") and true or false
                                        local replyData = nil
                                        if entry.replySender and entry.replySender~="" then
                                            replyData = {sender=entry.replySender, text=entry.replyText or entry.replySender}
                                        end
                                        if isStickerMsg then
                                            local msgRole = entry.role or "none"
                                            local msgUserId = entry.userId
                                            local hash = entry.sticker_hash
                                            local stickerId = entry.sticker
                                            if hash and hash~="" then
                                                local foundLocalId = nil
                                                for _,s in ipairs(MEME_STICKERS) do
                                                    if s.hash==hash and s.id and s.id~="" then foundLocalId=s.id break end
                                                end
                                                if foundLocalId then
                                                    addChatMessage(displayName, msg, false, msgRole, msgUserId, to, foundLocalId, replyData, hash, name)
                                                else
                                                    addChatMessage(displayName, msg, false, msgRole, msgUserId, to, "", replyData, hash, name)
                                                end
                                                showToast(name, getNick(msgUserId or 0, displayName), msg, avatarFallback(msgUserId), false)
                                            else
                                                if stickerId and stickerId~="" then
                                                    addChatMessage(displayName, msg, false, msgRole, msgUserId, to, stickerId, replyData, nil, name)
                                                    showToast(name, getNick(msgUserId or 0, displayName), msg, avatarFallback(msgUserId), false)
                                                end
                                            end
                                        else
                                            addChatMessage(displayName, msg, false, entry.role or "none", entry.userId, to, entry.sticker, replyData, entry.sticker_hash, name)
                                            showToast(name, getNick(entry.userId or 0, displayName), msg, avatarFallback(entry.userId), false)
                                            local otherPlayer = Players:FindFirstChild(name)
                                            if otherPlayer and otherPlayer.Character then makeBubble(otherPlayer.Character, msg) end
                                        end
                                    end
                                end
                            else seenIds[id]=true end
                            if ts>maxTs then maxTs=ts end
                        end
                    end
                end
            end
        end
        lastTimestamp = maxTs
    end

    local fetchInProgress = false
    local lastFetchStarted = 0
    local function fetchNewMessages()
        local now = os.clock()
        if fetchInProgress or now-lastFetchStarted < MIN_FETCH_GAP then return end
        fetchInProgress = true
        lastFetchStarted = now
        local ok, err = pcall(fetchNewMessagesUnsafe)
        fetchInProgress = false
        if not ok then warn("[RX CHAT] message fetch: "..tostring(err)) end
    end

    local function handleCommand(text)
        local parts = {}
        for w in text:gmatch("%S+") do parts[#parts+1]=w end
        local cmd = parts[1] and parts[1]:lower() or ""
        if cmd=="/clear" then
            for _,child in pairs(scroller:GetChildren()) do
                if (child:IsA("TextLabel") or child:IsA("Frame")) and child.Name~="BottomSpacer" then child:Destroy() end
            end
            messageQueue = {}
            trackedHeight=0
            return true
        elseif cmd=="/clearall" then
            if myRole=="none" then
                addSystemMessage("🚫 Unauthorized command: /clearall", Color3.fromRGB(255,80,80))
                return true
            end
            clearAllMessages()
            return true
        elseif cmd=="/addmeme" then
            local id = parts[2] local name = parts[3] or "MEME"
            if id then addCustomSticker(id, name) return true end
            addSystemMessage("Usage: /addmeme 123177152458601 NAME", Color3.fromRGB(255,200,0)) return true
        elseif cmd=="/addmemeurl" then
            local url = parts[2] local name = parts[3] or "MEME"
            if url then addCustomStickerURL(url, name) return true end
            addSystemMessage("Usage: /addmemeurl <url> <name>", Color3.fromRGB(255,200,0)) return true
        elseif cmd=="/memelist" then
            for i,s in ipairs(MEME_STICKERS) do
                addSystemMessage(i..". "..s.name.." - "..(s.id and s.id:sub(1,50) or ""), Color3.fromRGB(200,200,255))
            end
            return true
        elseif cmd=="/syncmemes" then
            runMemeSyncOnce(true)
            return true
        elseif cmd=="/stopmemessync" or cmd=="/stopsyncmemes" then
            stopMemeSync()
            addSystemMessage("Meme sync stopped", Color3.fromRGB(255,200,100))
            return true
        elseif cmd=="/reloadmemes" then
            invalidateMemeListCache()
            loadCustomStickers() refreshStickers() addSystemMessage("Reloaded "..#MEME_STICKERS.." memes", Color3.fromRGB(100,255,100)) return true
        elseif cmd=="/clearmemes" then
            if myRole~="owner" then
                addSystemMessage("🚫 Unauthorized command: /clearmemes (owner only)", Color3.fromRGB(255,80,80))
                return true
            end
            httpPut(STICKERS_ROOT..".json","{}") httpPut(SYNCED_MEMES_ROOT..".json","{}")
            MEME_STICKERS = {{name="MY_MEME", id="rbxassetid://85535407882603"}, {name="ASSET_123177152458601", id="rbxassetid://123177152458601"}}
            syncedHashes = {}
            for _,b in pairs(drawnStickerKeys) do if b.Parent then b:Destroy() end end
            drawnStickerKeys = {}
            refreshStickers()
            return true
        elseif cmd=="/deleteallmemes" then
            if myRole~="owner" then
                addSystemMessage("🚫 Unauthorized command: /deleteallmemes (owner only)", Color3.fromRGB(255,80,80))
                return true
            end
            deleteAllServerMemes()
            return true
        elseif cmd=="/dedupemusic" then
            task.spawn(function()
                local n = MX.dedupe and MX.dedupe(true) or 0
                addSystemMessage("🧹 rx_music: "..n.." duplicate local file(s) removed", Color3.fromRGB(100,255,100))
                if myRole=="owner" then
                    local r = MX.cleanFirebase and MX.cleanFirebase()
                    if r == nil then
                        addSystemMessage("Firebase cleanup skipped (could not read rx_music, check rules).", Color3.fromRGB(255,100,100))
                    else
                        addSystemMessage("🧹 Firebase rx_music: "..r.." orphan entr"..(r==1 and "y" or "ies").." removed", Color3.fromRGB(100,255,100))
                    end
                else
                    addSystemMessage("Firebase cleanup is owner-only.", Color3.fromRGB(255,200,100))
                end
                if MX.refresh then MX.refresh() end
            end)
            return true
        elseif cmd=="/deleteallmusic" or cmd=="/clearmusic" then
            if myRole~="owner" then
                addSystemMessage("🚫 Unauthorized command: /deleteallmusic (owner only)", Color3.fromRGB(255,80,80))
                return true
            end
            task.spawn(function()
                -- true = node empty, false = still has data, nil = could not read it
                local function isEmpty(root)
                    local resp = httpGetFresh(root..".json?shallow=true")
                    if resp == nil then return nil end
                    local s = tostring(resp):gsub("%s+","")
                    if s=="null" or s=="{}" then return true end
                    if s:find('"error"',1,true) then return nil end
                    return false
                end
                local function wipe()
                    httpPut(MX.root..".json","{}")
                    httpPut(MX.index..".json","{}")
                end
                wipe()
                local e1, e2 = isEmpty(MX.root), isEmpty(MX.index)
                if e1==false or e2==false then
                    task.wait(0.5)
                    wipe()
                    e1, e2 = isEmpty(MX.root), isEmpty(MX.index)
                end
                if e1==true and e2==true then
                    addSystemMessage("All server music deleted from Firebase\n(verified empty).\nLocal rx_music files were kept.", Color3.fromRGB(255,200,100))
                elseif e1==false or e2==false then
                    addSystemMessage("Delete sent but Firebase still has music (check database rules).", Color3.fromRGB(255,100,100))
                else
                    addSystemMessage("Delete sent but could not verify Firebase is empty. Press the music refresh button to check.", Color3.fromRGB(255,200,100))
                end
                if MX.refresh then MX.refresh() end
            end)
            return true
        elseif cmd=="/showblockedusers" then
            showBlockedUsersWindow()
            return true
        elseif cmd=="/help" then
            local helpCommands={"/clear","/clearall","/addmeme","/addmemeurl","/syncmemes","/stopmemessync","/stopsyncmemes","/reloadmemes","/memelist","/showblockedusers","/dedupemusic","/help"}
            if myRole=="owner" then
                table.insert(helpCommands, "/deleteallmemes")
                table.insert(helpCommands, "/deleteallmusic")
                table.insert(helpCommands, "/clearmusic")
            end
            addSystemMessage(table.concat(helpCommands,"\n"))
            return true
        end
        return false
    end

    local lastSend = 0
    local function submitMessage()
        if os.clock()-lastSend<0.6 then return end
        local text = inputBox.Text:gsub("^%s+",""):gsub("%s+$","")
        if text=="" then return end
        lastSend = os.clock()
        local currentText = text
        inputBox.Text = ""
        if currentText:sub(1,1)=="/" then
            if not handleCommand(currentText) then addSystemMessage("Unknown command.", Color3.fromRGB(255,100,100)) end
        else
            sendToServer(player.Name, player.DisplayName, currentText)
        end
    end
    local function safeRuntimeCall(fn)
        local ok, err = pcall(fn)
        if not ok then warn("RX Chat protected error: "..tostring(err)) end
        return ok
    end
    sendBtn.MouseButton1Click:Connect(submitMessage)
    inputBox.FocusLost:Connect(function(enter) if enter then submitMessage() end end)

    local playerAddedConn = Players.PlayerAdded:Connect(function(newPlayer)
        if newPlayer==player then return end
    end)
    table.insert(connections, playerAddedConn)

    addSystemMessage("Welcome to RX Chat, "..getNick(player.UserId, player.DisplayName).."!", Color3.fromRGB(200,220,255))
    addSystemMessage("/syncmemes to sync memes", Color3.fromRGB(100,255,100))
    addSystemMessage("/stopsyncmemes to stop", Color3.fromRGB(100,255,100))
    addSystemMessage("Use the RX Music Player 🔄 button to sync rx_music", Color3.fromRGB(100,255,100))
    addSystemMessage("/help for commands", Color3.fromRGB(100,255,100))
    task.spawn(function()
        if alive then
            local welcomeAvatar = getAvatar(player.UserId)
            if alive then showWelcomeCard(getNick(player.UserId, player.DisplayName), welcomeAvatar) end
        end
    end)
    task.spawn(function()
        task.wait(3)
        if alive then
            safeRuntimeCall(function()
                local joinSlot = math.floor(os.time() / 1800)
                local isOwnerSender = (myRole == "owner")
                local joinId = "join_"..tostring(player.UserId).."_"..tostring(joinSlot)
                if isOwnerSender then joinId = joinId.."_"..tostring(os.time()).."_"..tostring(math.random(1000,9999)) end
                httpPost(FIREBASE_URL, jsonEncode({
                    name=player.Name,
                    displayName=player.DisplayName,
                    userId=player.UserId,
                    message=player.DisplayName.." joined RX Chat",
                    timestamp={[".sv"]="timestamp"},
                    id=joinId,
                    role=myRole,
                    system=true,
                    event="join"
                }))
            end)
        end
    end)

    task.spawn(function()
        while alive do
            safeRuntimeCall(function()
                -- [EDIT 2] Use Firebase server timestamp so clock skew across clients doesn't break presence.
                httpPut(PRESENCE_ROOT.."/"..tostring(player.UserId)..".json", jsonEncode({
                    name=player.Name, displayName=player.DisplayName, userId=player.UserId,
                    placeId=game.PlaceId, jobId=game.JobId,
                    lastSeen={[".sv"]="timestamp"}, role=myRole
                }))
            end)
            task.wait(PRESENCE_INTERVAL)
        end
        safeRuntimeCall(function()
            local resp = httpGetFresh(MUSIC_PRESENCE_URL)
            local data = jsonDecode(resp or "{}")
            if data and tonumber(data.byUserId)==player.UserId then httpDelete(MUSIC_PRESENCE_URL) end
        end)
    end)

    task.spawn(function()
        while alive do
            safeRuntimeCall(function() fetchGlobalBlocks(false) end)
            if onlinePanel.Visible then safeRuntimeCall(function() refreshOnlineList(false) end) end
            task.wait(BLOCKS_INTERVAL)
        end
    end)

    task.spawn(function()
        while alive do
            safeRuntimeCall(function()
                local raw = httpGetFresh(CONTROL_URL)
                local control = jsonDecode(raw or "{}")
                local controlTime = tonumber(control.timestamp) or 0
                if control.action=="kick" and controlTime>=SESSION_STARTED_AT and not hasNotifiedKick then
                    hasNotifiedKick=true
                    addSystemMessage("You were kicked by "..tostring(control.by or "moderator"), Color3.fromRGB(255,80,80))
                    task.wait(1)
                    pcall(function() httpDelete(PRESENCE_ROOT.."/"..tostring(player.UserId)..".json") end)
                    sg:Destroy()
                    return
                elseif control.action=="block" and controlTime>=SESSION_STARTED_AT then
                    unblockPending=true
                    if not hasNotifiedBlock then
                        blockedUsers["__ALL__"]=true
                        addSystemMessage("You have been blocked.", Color3.fromRGB(255,80,80))
                        hasNotifiedBlock=true
                    else
                        blockedUsers["__ALL__"]=true
                    end
                else
                    if not globalBlocks[tostring(player.UserId)] and control.action~="block" then
                        if hasNotifiedBlock then
                            blockedUsers["__ALL__"]=nil
                            hasNotifiedBlock=false
                        end
                        if unblockPending then
                            unblockPending=false
                            blockedUsers["__ALL__"]=nil
                            addSystemMessage("You are unblocked! ✅", Color3.fromRGB(0,255,0))
                        end
                    end
                end
            end)
            task.wait(CONTROL_INTERVAL)
        end
    end)

    task.spawn(function()
        while alive do
            task.wait(POLL_INTERVAL)
            safeRuntimeCall(fetchNewMessages)
        end
    end)

    addSystemLinkMessage("https://downloadrxchatapp.netlify.app/")
    addSystemMessage("RX CHAT CONNECTED", Color3.fromRGB(100,255,100))
    scrollToLatest()
    task.spawn(function()
        task.wait(0.15)
        if not alive then return end
        safeRuntimeCall(fetchNewMessages)
    end)
    task.spawn(function()
        task.wait(0.45)
        if not alive then return end
        safeRuntimeCall(function() refreshOnlineList(false) end)
    end)
    print("[RX] buildUI() finished — RX Chat V10 Ready")
end

