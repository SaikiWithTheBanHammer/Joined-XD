    local function fetchGlobalBlocks(force)
        local now = os.clock()
        if not force and (now-lastBlocksFetch)<BLOCKS_FETCH_COOLDOWN then return end
        lastBlocksFetch = now
        local resp = httpGet(BLOCKS_URL)
        local data = jsonDecode(resp or "{}")
        globalBlocks = {}
        if type(data)=="table" then
            for uid, entry in pairs(data) do
                if type(entry)=="table" then
                    local ts = tonumber(entry.timestamp) or 0
                    if ts>=SESSION_STARTED_AT then globalBlocks[uid]=entry
                    else httpDelete(BLOCKS_ROOT.."/"..uid..".json") httpDelete(CONTROLS_ROOT.."/"..uid..".json") end
                end
            end
        end
        if globalBlocks[tostring(player.UserId)] then blockedUsers["__ALL__"]=true
        else if hasNotifiedBlock and not globalBlocks[tostring(player.UserId)] then blockedUsers["__ALL__"]=nil hasNotifiedBlock=false end end
