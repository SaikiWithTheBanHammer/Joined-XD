end

local function pathToAsset(path)
    if not path then return nil end
    local a = nil
    for _=1,3 do
        pcall(function() if type(getcustomasset)=="function" then a=getcustomasset(path) end end)
        if a and a~="" then return a end
        pcall(function() if type(getsynasset)=="function" then a=getsynasset(path) end end)
        if a and a~="" then return a end
        task.wait(0.2)
    end
    return nil
end

