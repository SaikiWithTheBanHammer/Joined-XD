local httpCache = {}
local httpCacheOrder = {}
local function cacheGet(url)
    local e = httpCache[url]
    if e and (os.clock()-e.t) < HTTP_CACHE_TTL then return e.body end
    return nil
end
local function cachePut(url, body)
    if not body then return end
    if not httpCache[url] then httpCacheOrder[#httpCacheOrder+1] = url end
    httpCache[url] = {body=body, t=os.clock()}
    if #httpCacheOrder > 40 then
        for i=1,20 do
            local u = table.remove(httpCacheOrder, 1)
            if u then httpCache[u] = nil end
        end
    end
end

local function httpGet(url, useCache)
    if useCache ~= false then
        local c = cacheGet(url)
        if c then return c end
    end
    local body = nil
    if Req then
        local ok, res = pcall(function() return Req({Url=url, Method="GET"}) end)
        if ok and res and res.Body and res.Body ~= "" then body = res.Body end
    end
    if not body then
        local ok, r = pcall(function() return HttpService:GetAsync(url, false) end)
        if ok and r and r ~= "" then body = r end
    end
    if not body then
        local ok, r = pcall(function()
            local x = HttpService:RequestAsync({Url=url, Method="GET"})
            return x and x.Success and x.Body or nil
        end)
        if ok and r and r ~= "" then body = r end
    end
    if not body then
        local ok, r = pcall(function() return game:HttpGet(url) end)
        if ok and r then body = r end
    end
    if body then cachePut(url, body) end
    return body
end
local function httpGetFresh(url) return httpGet(url, false) end

local function isHttpSuccess(res)
    local status = res and tonumber(res.StatusCode)
    return not status or (status >= 200 and status < 300)
end

local function httpPost(url, data)
    if type(data)=="string" and data~="{}" and data:sub(1,1)=="{" then data = '{"rx":1,'..data:sub(2) end
    if Req then
        local ok, res = pcall(function() return Req({Url=url, Method="POST", Headers={["Content-Type"]="application/json"}, Body=data}) end)
        if ok and res and isHttpSuccess(res) and res.Body then return res.Body end
        if ok and res and isHttpSuccess(res) and res.StatusCode==204 then return "{}" end
    end
    local ok, res = pcall(function() return game:HttpPost(url, data, Enum.HttpContentType.ApplicationJson) end)
    return ok and res or nil
end

local function httpPut(url, data)
    if Req then
        local ok, res = pcall(function() return Req({Url=url, Method="PUT", Headers={["Content-Type"]="application/json"}, Body=data}) end)
        if ok and res and isHttpSuccess(res) and (res.Body or res.StatusCode==200) then return res.Body or "{}" end
        return nil
    end
    local ok, res = pcall(function() return game:HttpPost(url, data, Enum.HttpContentType.ApplicationJson) end)
    if ok then return res or "{}" end
    return nil
end

