    local function sharedMusicClockMs()
        local ok, value = pcall(function() return workspace:GetServerTimeNow() end)
        if ok and tonumber(value) then return tonumber(value)*1000 end
        local dateOk, dateValue = pcall(function() return DateTime.now().UnixTimestampMillis end)
        if dateOk and tonumber(dateValue) then return tonumber(dateValue) end
