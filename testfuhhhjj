local function fetchPagedObject(root, pageSize)
    local merged = {}
    local cursor = nil
    pageSize = math.max(1, tonumber(pageSize) or 3)
    for _=1,250 do
        local url = root..".json?orderBy=%22$key%22&limitToFirst="..tostring(pageSize)
        if cursor then url = url.."&startAt=%22"..HttpService:UrlEncode(cursor).."%22" end
        local raw = httpGetFresh(url)
        local page = jsonDecode(raw or "{}")
        if type(page)~="table" then break end
        local keys = {}
        for key in pairs(page) do keys[#keys+1] = tostring(key) end
        table.sort(keys)
        if #keys==0 then break end
        local added = 0
        for _,key in ipairs(keys) do
            if not cursor or key>cursor then merged[key]=page[key] added=added+1 end
        end
        if added==0 then break end
        cursor = keys[#keys]
        if #keys<pageSize then break end
    end
    return merged
end

