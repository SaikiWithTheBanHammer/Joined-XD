                        sysMsg("No local MP3 for this row; Firebase was not changed.", BLUE)
                        return
                    end
                    if type(delfile)~="function" then
                        sysMsg("This executor cannot delete local files.", RED)
                        return
                    end
                    if not deleteArmed then
                        deleteArmed = true
                        deleteBtn.Text="Confirm?"
                        task.delay(3, function()
                            if deleteBtn.Parent and deleteArmed then
                                deleteArmed = false
                                deleteBtn.Text="Delete"
                            end
                        end)
                        return
                    end
                    deleteArmed = false
                    local deleteOk, deleteResult = pcall(delfile, path)
                    local verifyOk, stillExists = true, false
                    if isfile then verifyOk, stillExists = pcall(isfile, path) end
                    if deleteOk and deleteResult~=false and verifyOk and not stillExists then
                        MX.hashCache[path] = nil
                        legacyHashCache[path] = nil
                        e.localPath = nil
                        sysMsg("Deleted local MP3: "..tostring(e.name).." (Firebase copy unchanged)", Color3.fromRGB(100,255,100))
                        if MX.refresh then MX.refresh() end
                    else
                        deleteBtn.Text="Delete"
                        sysMsg("Could not delete local MP3: "..tostring(path), RED)
                    end
                end)
            end
        end

