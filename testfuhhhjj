    local musicFetchInProgress = false
    local lastMusicFetch = 0
    local musicPresenceInitialized = false
    local lastMusicPresenceSignature = nil
    task.spawn(function()
        while alive do
            task.wait(MUSIC_POLL_INTERVAL)
            pcall(function()
                local nowClock = os.clock()
                if musicFetchInProgress or nowClock-lastMusicFetch < MUSIC_POLL_INTERVAL-1 then return end
                musicFetchInProgress = true
                lastMusicFetch = nowClock
                if not alive then return end
                local resp = httpGetFresh(MUSIC_PRESENCE_URL)
                if resp and resp~="null" and #resp>10 then
                    local data = jsonDecode(resp)
                    if type(data)=="table" and (data.assetId or data.musicAssetId) then
                        local ts = tonumber(data.timestamp) or 0
                        local action = data.musicAction or data.action or "play"
                        local assetId = data.musicAssetId or data.assetId or ""
                        local startAtMs = tonumber(data.startAt)
                        local signature = table.concat({
                            tostring(data.id or ""), tostring(ts), tostring(action), tostring(assetId),
                            tostring(data.musicHash or ""), tostring(data.startAt or "")
                        }, "|")
                        local firstPresenceSnapshot = not musicPresenceInitialized
                        if firstPresenceSnapshot or signature~=lastMusicPresenceSignature or (ts~=0 and ts>lastMusicTs) then
                            musicPresenceInitialized = true
                            lastMusicPresenceSignature = signature
                            if action=="prepare" and data.musicType=="file" and tostring(data.musicHash or ""):match("^%x+_%d+$") then
                                local prepId = safeMusicSessionId(data.sessionId or data.id)
                                if prepId~="" then
                                    if ts~=0 then lastMusicTs=math.max(lastMusicTs,ts) end
                                    stopAllMusicSafe(true)
                                    MX.activePrepareId=prepId
                                    isServerActive=true
                                    local prepHash, prepName = tostring(data.musicHash), data.musicName
                                    task.spawn(function() pcall(MX.prepareSynced, prepHash, prepName, prepId) end)
                                    task.delay(MUSIC_READY_TIMEOUT_MS/1000+10, function()
                                        if MX.activePrepareId==prepId then
                                            MX.activePrepareId=nil
                                            if not currentSound then isServerActive=false end
                                            if addSystemMessage then addSystemMessage("⏱ Server song preparation expired.", Color3.fromRGB(255,200,100)) end
                                        end
                                    end)
                                end
                            elseif tonumber(data.byUserId)~=player.UserId then
                                if action=="stop" or assetId=="" then
                                    MX.activePrepareId=nil
                                    if currentSound or isServerActive then stopAllMusicSafe(true) end
                                    isServerActive=false
                                    if ts~=0 then lastMusicTs=math.max(lastMusicTs,ts) end
                                    if not firstPresenceSnapshot and addSystemMessage then
                                        addSystemMessage("🔇 Server stopped by "..(data.by or "STAFF"), Color3.fromRGB(255,200,100))
                                    end
                                elseif action=="play" and assetId~="" then
                                    MX.activePrepareId=nil
                                    if ts~=0 then lastMusicTs=math.max(lastMusicTs,ts) end
                                    stopAllMusicSafe(true)
                                    isServerActive=true
                                    if data.musicType=="file" and tostring(data.musicHash or ""):match("^%x+_%d+$") then
                                        local recvAt = os.clock()
                                        local fHash, fName, fBy = tostring(data.musicHash), data.musicName, data.by or "STAFF"
                                        local playbackStartMs = tonumber(startAtMs)
                                        if (not playbackStartMs or playbackStartMs<1000000000000) and firstPresenceSnapshot then playbackStartMs=ts end
                                        local resumeLateJoin = firstPresenceSnapshot and playbackStartMs and playbackStartMs<sharedMusicClockMs()-500 or false
                                        if addSystemMessage and not firstPresenceSnapshot then addSystemMessage("📥 Song from "..tostring(fBy)..": "..tostring(fName), Color3.fromRGB(150,200,255)) end
                                        task.spawn(function()
                                            pcall(MX.playSynced, fHash, fName, "server", fBy, recvAt, playbackStartMs, resumeLateJoin==true)
                                            if firstPresenceSnapshot and addSystemMessage then
                                                -- joined mid-session: only announce if the server song is actually live
                                                local deadline = os.clock() + 20
                                                while alive and isServerActive and currentMusicType=="server" and currentSound and os.clock()<deadline do
                                                    local snd = currentSound
                                                    local ok, loaded, playing, length = pcall(function() return snd.IsLoaded, snd.IsPlaying, snd.TimeLength end)
                                                    if ok and loaded and playing and length>0 then
                                                        if currentSound==snd and isServerActive then
                                                            addSystemMessage("📥 Song from "..tostring(fBy)..": "..tostring(fName), Color3.fromRGB(150,200,255))
                                                        end
                                                        break
                                                    end
                                                    task.wait(0.1)
                                                end
                                            end
                                        end)
                                    else
                                        local serverSound = playMusicSafe(assetId,"server",nil,startAtMs)
                                        reportServerPlaybackWhenActive(serverSound, "🔊 SERVER: "..tostring(assetId):gsub("%D","").." BY "..string.upper(data.by or "STAFF"))
                                    end
                                end
                            else
                                if action=="play" then MX.activePrepareId=nil end
                                if ts~=0 then lastMusicTs=math.max(lastMusicTs,ts) end
                            end
                        end
                    end
                end
                musicFetchInProgress = false
            end)
            musicFetchInProgress = false
        end
    end)

