-- open animation (nudge up + fade) played whenever Visible turns true
function FX.reveal(obj)
    pcall(function()
        local tgt = FX.busy[obj] or obj.Position
        FX.busy[obj] = tgt
        local bgT = obj.BackgroundTransparency
        obj.Position = tgt + UDim2.fromOffset(0, 14)
        if bgT < 1 then obj.BackgroundTransparency = math.min(1, bgT + 0.5) end
        FX.tw(obj, 0.28, {Position=tgt, BackgroundTransparency=bgT})
        task.delay(0.32, function() if FX.busy[obj] == tgt then FX.busy[obj] = nil end end)
    end)
end
