function FX.tw(obj, t, props, style, dir)
    pcall(function()
        TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
    end)
end
function FX.corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = (typeof(r) == "UDim") and r or UDim.new(0, r or 8)
    c.Parent = obj
    return c
end
function FX.stroke(obj, col, th, tr)
    local s = Instance.new("UIStroke")
    s.Color = col s.Thickness = th or 1 s.Transparency = tr or 0
    pcall(function() s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border end)
    s.Parent = obj
    return s
end
function FX.gradStroke(obj, a, b, th, spin)
    local s = FX.stroke(obj, Color3.fromRGB(255,255,255), th or 1.5, 0)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({ColorSequenceKeypoint.new(0,a), ColorSequenceKeypoint.new(0.5,b), ColorSequenceKeypoint.new(1,a)})
    g.Parent = s
    if spin and spin ~= 0 then
        task.spawn(function()
            while obj.Parent do
                g.Rotation = (g.Rotation + spin) % 360
                task.wait(0.05)
            end
        end)
    end
    return s, g
end
function FX.centerAnchor(obj)
    pcall(function()
        if obj.AnchorPoint == Vector2.new(0.5,0.5) then return end
        local sx, sy = obj.Size.X, obj.Size.Y
        obj.AnchorPoint = Vector2.new(0.5,0.5)
        obj.Position = obj.Position + UDim2.new(sx.Scale/2, sx.Offset/2, sy.Scale/2, sy.Offset/2)
    end)
end
function FX.press(btn)
    pcall(function()
        FX.centerAnchor(btn)
        local sc = Instance.new("UIScale") sc.Parent = btn
        btn.MouseButton1Down:Connect(function() FX.tw(sc, 0.08, {Scale=0.9}) end)
        local function up() FX.tw(sc, 0.25, {Scale=1}, Enum.EasingStyle.Back) end
        btn.MouseButton1Up:Connect(up)
        btn.MouseLeave:Connect(up)
    end)
end
function FX.hover(btn, normal, over)
    pcall(function()
        btn.MouseEnter:Connect(function() FX.tw(btn, 0.15, {BackgroundColor3=over}) end)
        btn.MouseLeave:Connect(function() FX.tw(btn, 0.15, {BackgroundColor3=normal}) end)
    end)
end
