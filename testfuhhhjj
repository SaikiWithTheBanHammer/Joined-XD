    local function addCustomStickerURL(url, name)
        if not url then return end
        local stickerName = string.upper(name or "MEME_"..math.random(1000,9999))
        task.spawn(function()
            local finalId = url
            local path = WORKSPACE_MEME_FOLDER.."/"..stickerName..".png"
            ensureFolder(WORKSPACE_MEME_FOLDER)
            if writefile then
                local ok = false
                if Req then
                    local o, r = pcall(function() return Req({Url=url, Method="GET"}) end)
                    if o and r and r.Body and #r.Body>100 then pcall(writefile, path, r.Body) ok=true task.wait(0.4) end
                end
                if not ok then
                    local o, r = pcall(function() return game:HttpGet(url) end)
                    if o and r and #r>100 then pcall(writefile, path, r) ok=true task.wait(0.4) end
                end
                if ok then
                    invalidateMemeListCache()
                    local hash = fileHash(path)
                    if hash then
                        local ext = path:match("(%.[^%.]+)$") or ".png"
                        local canonical = WORKSPACE_MEME_FOLDER.."/"..hash..ext
                        if canonical~=path and not (isfile and isfile(canonical)) and readfile then
                            local ro, raw = pcall(readfile, path)
                            if ro and raw and writefile then pcall(writefile, canonical, raw) end
                        end
                        if canonical~=path and delfile and (isfile and isfile(canonical)) then pcall(delfile, path) end
                        path = canonical
                        invalidateMemeListCache()
                    end
                    local a = pathToAsset(path)
                    if a and a~="" then finalId=a end
                end
            end
            local stickerHash = fileHash(path)
            local sticker = {name=stickerName, id=finalId, hash=stickerHash or "", url=url, by=player.Name, timestamp=os.time()*1000}
            if not hasStickerByHashOrId(sticker.hash, sticker.id) then
                local stickerKey = memeServerKey(sticker.hash~="" and sticker.hash or url)
                httpPut(STICKERS_ROOT.."/"..stickerKey..".json", jsonEncode(sticker))
                table.insert(MEME_STICKERS, sticker)
                dedupWorkspaceMemeFiles(true)
                dedupStickers()
                refreshStickers()
            end
        end)
    end

    local isRefreshingOnline = false
    local lastOnlineRefresh = 0
    local ONLINE_REFRESH_COOLDOWN = 4
    local onlineRowMap = {}
    local onlineEmptyLabel = nil
    local function refreshOnlineList(force)
        local now = os.clock()
        if not force and now-lastOnlineRefresh < ONLINE_REFRESH_COOLDOWN then return end
        if isRefreshingOnline then return end
        isRefreshingOnline = true
        lastOnlineRefresh = now

        local resp = httpGetFresh(PRESENCE_URL)
        local data = jsonDecode(resp or "{}")
        if type(data)~="table" then
            isRefreshingOnline = false
            return
        end
        -- [EDIT 3] Base "now" on newest heartbeat instead of local clock.
        local nowMs = tonumber(data._now) or 0
        if nowMs==0 then
            for _, e in pairs(data) do
                if type(e)=="table" then
                    local ls = tonumber(e.lastSeen) or 0
                    if ls>nowMs then nowMs=ls end
                end
            end
            if nowMs==0 then nowMs=os.time()*1000 end
        end
        local latestByUid = {}
        for fbKey, entry in pairs(data) do
            if type(entry)=="table" then
                local uid = tostring(entry.userId or fbKey)
                if uid~="" and uid~="0" and uid~="nil" then
                    local lastSeen = tonumber(entry.lastSeen) or 0
                    if nowMs-lastSeen<40000 then
                        local exist = latestByUid[uid]
                        if not exist or lastSeen>(tonumber(exist.lastSeen) or 0) then latestByUid[uid]=entry end
                    end
                end
            end
        end
        local list = {}
        for _,e in pairs(latestByUid) do table.insert(list, e) end
        table.sort(list, function(a,b) return (a.displayName or a.name or ""):lower()<(b.displayName or b.name or ""):lower() end)

        local present = {}
        for _, entry in ipairs(list) do
            local uid = tostring(entry.userId or "")
            if uid~="" then present[uid]=true end
        end

        for uid, row in pairs(onlineRowMap) do
            if not present[uid] then
                if row.holder and row.holder.Parent then row.holder:Destroy() end
                onlineRowMap[uid] = nil
            end
        end

        local count = 0
        for idx, entry in ipairs(list) do
            local uid = tostring(entry.userId or "")
            if uid~="" then
                count = count + 1
                local role = resolveRole(entry.role, uid)
                local displayName = getOnlineName(uid, entry)
                local row = onlineRowMap[uid]

                if not row then
                    local holder = Instance.new("Frame")
                    holder.Size=UDim2.new(1,0,0,40) holder.BackgroundColor3=FX.T.PANEL_SOFT
                    holder.BackgroundTransparency=0.25 holder.BorderSizePixel=0 holder.Parent=onlineScroller
                    FX.corner(holder, 10)
                    local av = Instance.new("ImageLabel")
                    av.Size=UDim2.new(0,28,0,28) av.Position=UDim2.new(0,3,0,3)
                    av.BackgroundTransparency=1 av.Image=avatarFallback(uid) av.Parent=holder
                    FX.corner(av, UDim.new(0.5,0))
                    loadAvatarInto(av, uid, entry.name or entry.displayName)
                    local dot = Instance.new("Frame")
                    dot.Size=UDim2.new(0,6,0,6)
                    dot.Position=UDim2.new(0,28,0,25)
                    dot.BackgroundColor3=Color3.fromRGB(38,235,92)
                    dot.BorderSizePixel=1
                    dot.BorderColor3=FX.T.PANEL_SOFT
                    dot.ZIndex=3
                    dot.Parent=holder
                    local dotCorner = Instance.new("UICorner")
                    dotCorner.CornerRadius=UDim.new(0.5,0)
                    dotCorner.Parent=dot
                    local dotStroke = Instance.new("UIStroke")
                    dotStroke.Color=Color3.fromRGB(20,140,50)
                    dotStroke.Thickness=1
                    dotStroke.Parent=dot
                    local nameLbl = Instance.new("TextLabel")
                    nameLbl.Size=UDim2.new(1,-112,0,20) nameLbl.Position=UDim2.new(0,48,0,1)
                    nameLbl.BackgroundTransparency=1
                    nameLbl.Font=Enum.Font.GothamBold nameLbl.TextSize=12
                    nameLbl.TextXAlignment=Enum.TextXAlignment.Left nameLbl.TextYAlignment=Enum.TextYAlignment.Center
                    nameLbl.Parent=holder
                    local userLbl = Instance.new("TextLabel")
                    userLbl.Size=UDim2.new(1,-112,0,16) userLbl.Position=UDim2.new(0,48,0,21)
                    userLbl.BackgroundTransparency=1
                    userLbl.TextColor3=FX.T.DIM
                    userLbl.Font=Enum.Font.Gotham userLbl.TextSize=10
                    userLbl.TextXAlignment=Enum.TextXAlignment.Left userLbl.TextYAlignment=Enum.TextYAlignment.Center
                    userLbl.Parent=holder
                    local joinBtn = Instance.new("TextButton")
                    joinBtn.Name = "JoinServerButton"
                    joinBtn.Size = UDim2.new(0,54,0,25)
                    joinBtn.AnchorPoint = Vector2.new(1,0.5)
                    joinBtn.Position = UDim2.new(1,-5,0.5,0)
                    joinBtn.BackgroundColor3 = Color3.fromRGB(20,125,220)
                    joinBtn.BorderSizePixel = 0
                    joinBtn.Text = "JOIN"
                    joinBtn.TextColor3 = Color3.fromRGB(255,255,255)
                    joinBtn.Font = Enum.Font.GothamBold
                    joinBtn.TextSize = 10
                    joinBtn.AutoButtonColor = true
                    joinBtn.Parent = holder
                    FX.corner(joinBtn, 7)
                    joinBtn.MouseButton1Click:Connect(function()
                        local target = row and row.entry
                        local placeId = target and tonumber(target.placeId)
                        local jobId = target and tostring(target.jobId or "") or ""
                        if not placeId or placeId <= 0 or jobId == "" or jobId == "nil" then
                            joinBtn.Text = "N/A"
                            task.delay(1.2, function() if joinBtn and joinBtn.Parent then joinBtn.Text = "JOIN" end end)
                            return
                        end
                        joinBtn.Text = "..."
                        local ok, err = pcall(function()
                            TeleportService:TeleportToPlaceInstance(placeId, jobId, player)
                        end)
                        if not ok then
                            warn("[RX] Join server failed: "..tostring(err))
                            joinBtn.Text = "FAIL"
                            task.delay(1.5, function() if joinBtn and joinBtn.Parent then joinBtn.Text = "JOIN" end end)
                        end
                    end)
                    FX.rowIn(holder, av, nameLbl, userLbl, idx) FX.registerDot(dot)
                    row = {holder=holder, av=av, nameLbl=nameLbl, userLbl=userLbl, joinBtn=joinBtn, entry=entry}
                    onlineRowMap[uid] = row
                end

                row.entry = entry
                local targetPlaceId = tonumber(entry.placeId)
                local targetJobId = tostring(entry.jobId or "")
                local canJoinTarget = targetPlaceId and targetPlaceId > 0 and targetJobId ~= "" and targetJobId ~= "nil"
                if row.joinBtn and row.joinBtn.Parent then
                    row.joinBtn.Text = canJoinTarget and "JOIN" or "N/A"
                    row.joinBtn.BackgroundColor3 = canJoinTarget and Color3.fromRGB(20,125,220) or Color3.fromRGB(75,80,90)
                    row.joinBtn.AutoButtonColor = canJoinTarget and true or false
                end
                local newNameText = getOnlineTag(role, uid)..displayName
                local newNameColor = getOnlineColor(role, uid)
                local newUserText = (entry.name and ("@"..tostring(entry.name)) or "")
                if row.nameLbl.Text ~= newNameText then row.nameLbl.Text = newNameText end
                if row.nameLbl.TextColor3 ~= newNameColor then row.nameLbl.TextColor3 = newNameColor end
                if row.userLbl.Text ~= newUserText then row.userLbl.Text = newUserText end
                if row.holder.LayoutOrder ~= idx then row.holder.LayoutOrder = idx end

                if idx % UI_BUILD_YIELD_EVERY == 0 then task.wait() end
            end
        end

        if count==0 then
            if not onlineEmptyLabel or not onlineEmptyLabel.Parent then
                onlineEmptyLabel = Instance.new("TextLabel")
                onlineEmptyLabel.Size=UDim2.new(1,0,0,30) onlineEmptyLabel.BackgroundTransparency=1
                onlineEmptyLabel.Text="No one online" onlineEmptyLabel.TextColor3=Color3.fromRGB(150,150,150)
                onlineEmptyLabel.TextSize=11 onlineEmptyLabel.Font=Enum.Font.Gotham
                onlineEmptyLabel.LayoutOrder=0
                onlineEmptyLabel.Parent=onlineScroller
            end
            onlineScroller.CanvasSize=UDim2.new(0,0,0,30)
            FX.setOnlineCount(0)
        else
            if onlineEmptyLabel and onlineEmptyLabel.Parent then
                onlineEmptyLabel:Destroy()
                onlineEmptyLabel = nil
            end
            onlineScroller.CanvasSize=UDim2.new(0,0,0,count*43)
            FX.setOnlineCount(count)
        end

        isRefreshingOnline = false
    end

